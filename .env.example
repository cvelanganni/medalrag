# ── LLMs ──────────────────────────────────────────────────────
# Required: at least one LLM provider
OPENAI_API_KEY=          # Required — used for generation, NER, triplet extraction
ANTHROPIC_API_KEY=       # Optional — enables Claude models in the UI
DEEPSEEK_API_KEY=        # Optional — enables DeepSeek models in the UI

# ── Qdrant (vector database) ───────────────────────────────────
# Run locally with: docker compose up qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=          # Optional — only needed for Qdrant Cloud
QDRANT_COLLECTION_EN=medical_docs_en
QDRANT_COLLECTION_ES=medical_docs_es

# ── Neo4j (knowledge graph) ────────────────────────────────────
# Run locally with: docker compose up neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=          # Required — set during Neo4j setup
NEO4J_DATABASE=neo4j

# ── Ollama (local embeddings) ──────────────────────────────────
# Run locally: ollama pull bge-m3
OLLAMA_URL=http://localhost:11434

# ── Chainlit (web interface) ───────────────────────────────────
# Required to run the app
CHAINLIT_AUTH_SECRET=    # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_USER=doctor
AUTH_PASSWORD=           # Set your own password
DATABASE_URL=            # PostgreSQL URL for conversation persistence

# ── LangSmith (optional tracing) ──────────────────────────────
LANGSMITH_API_KEY=       # Optional — remove to disable tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=medalrag-hiv
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ── UMLS (optional graph enrichment) ──────────────────────────
# Only needed to run enrich_graph.py
# Free key at: https://uts.nlm.nih.gov
UMLS_API_KEY=